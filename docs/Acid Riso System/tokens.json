{
  "$name": "Acid Riso",
  "$description": "Gritty neo-psychedelic design language for Ryan Gildea — Mix / Master / Produce. Risograph spot inks, off-register CMYK print, living film grain.",
  "$version": "1.0.0",
  "color": {
