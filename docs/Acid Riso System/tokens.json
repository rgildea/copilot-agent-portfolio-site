      "body-l":    { "value": "18px", "comment": "Hanken 400 / 1.6" },
      "body":      { "value": "16px", "comment": "Hanken 400 / 1.65" },
      "label":     { "value": "12px", "comment": "Space Mono UPPER / +1.5" }
    },
