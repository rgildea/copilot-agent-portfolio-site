---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { marked } from "marked";
import DOMPurify from "isomorphic-dompurify";

import about from "../data/about.json";
import contact from "../data/contact.json";

const socialIconMap = {
  "fa-linkedin": "icon-linkedin",
  "fa-instagram": "icon-instagram",
  "fa-github": "icon-github",
  "fa-facebook": "icon-facebook",
  "fa-hashtag": "icon-hashtag",
  "fa-twitter": "icon-twitter",
  "fa-cloud": "icon-cloud",
};

const portfolioItems = (await getCollection("portfolio")).sort(
  (a, b) => a.data.order - b.data.order,
);
const audioItems = portfolioItems.filter(
  (item) => item.data.audioTracks && item.data.audioTracks.length > 0,
);
const aboutBioHtml = DOMPurify.sanitize(marked.parse(about.bio), {
  ALLOWED_TAGS: [
    "p",
    "strong",
    "em",
    "a",
    "ul",
    "ol",
    "li",
    "br",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
  ],
  ALLOWED_ATTR: ["href", "target", "rel"],
});
---

<Base
  title="Ryan Gildea | Audio Engineer & Producer"
  hasListenSection={audioItems.length > 0}
>
  <!-- Hero -->
  <header class="hero">
    <div class="hero-backgrounds">
      <div class="hero-bg bg-1"></div>
      <div class="hero-bg bg-2"></div>
      <div class="hero-bg bg-3"></div>
    </div>
    <div class="hero-content">
      <div class="hero-eyebrow">
        Boutique Mix &amp; Master &middot; Neo-Psych Specialist
      </div>
      <h1 id="hero-name">Ryan Gildea</h1>
      <h2>Music Production | Mixing | Mastering</h2>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">Get Started</a>
        <a href="#listen" class="btn btn-secondary">Hear the Work</a>
      </div>
      <div class="spotify-direct-embed" id="spotify-facade">
        <button class="spotify-facade-btn" aria-label="Load Spotify playlist">
          <img
            src="/images/spotify-placeholder.jpg"
            alt=""
            class="spotify-facade-img"
            aria-hidden="true"
          />
          <div class="spotify-facade-content">
            <svg
              class="spotify-facade-play"
              viewBox="0 0 64 64"
              aria-hidden="true"
            >
              <circle cx="32" cy="32" r="32"></circle>
              <polygon points="24,16 48,32 24,48"></polygon>
            </svg>
          </div>
        </button>
      </div>
    </div>
    <a
      href="#about"
      class="scroll-indicator"
      aria-label="Scroll to About section"
    >
      <div class="scroll-text">Scroll for more</div>
      <div class="scroll-arrow">
        <svg class="icon" aria-hidden="true"
          ><use href="/icons.svg#icon-chevron-down"></use></svg>
      </div>
    </a>
  </header>

  <main>
    <!-- About -->
    <section id="about" class="about-section">
      <div class="container">
        <h2 class="section-title">About Me</h2>
        <div class="about-content">
          <div class="about-text" set:html={aboutBioHtml} />
          <div class="skills">
            <h3>Skills</h3>
            <ul class="skill-list">
              {about.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Listen -->
    {
      audioItems.length > 0 && (
        <section id="listen" class="listen-section">
          <div class="container">
            <h2 class="section-title">Rough vs. Final</h2>
            <p class="section-desc">
              Listen to the same track before and after mixing to hear how a
              professional mix can improve the clarity and emotional impact of a
              record.
            </p>
            <div class="listen-cards">
              {audioItems.map((item) => (
                <div
                  class="listen-card"
                  data-tracks={JSON.stringify(item.data.audioTracks)}
                >
                  <div class="listen-card__header">
                    {item.data.image.startsWith("/images/portfolio/") ? (
                      <picture>
                        <source
                          srcset={item.data.image.replace(/\.[^.]+$/, ".webp")}
                          type="image/webp"
                        />
                        <img
                          src={item.data.image}
                          alt={item.data.title}
                          class="listen-card__thumb"
                          width="48"
                          height="48"
                          loading="lazy"
                        />
                      </picture>
                    ) : (
                      <img
                        src={item.data.image}
                        alt={item.data.title}
                        class="listen-card__thumb"
                        width="48"
                        height="48"
                        loading="lazy"
                      />
                    )}
                    <div class="listen-card__meta">
                      <div class="listen-card__artist-name">
                        {item.data.title}
                      </div>
                      <div class="listen-card__role">{item.data.role}</div>
                    </div>
                  </div>

                  <div
                    class="listen-card__tabs"
                    role="tablist"
                    aria-label="Tracks"
                  >
                    {item.data.audioTracks!.map((track, i) => (
                      <button
                        type="button"
                        id={`tab-${item.id.replace(/\.[^.]+$/, "")}-${i}`}
                        class={`listen-tab${i === 0 ? " active" : ""}`}
                        role="tab"
                        aria-selected={i === 0 ? "true" : "false"}
                        aria-controls={`panel-${item.id.replace(/\.[^.]+$/, "")}`}
                        tabindex={i === 0 ? 0 : -1}
                        data-track-index={String(i)}
                      >
                        {track.title}
                      </button>
                    ))}
                  </div>

                  <div
                    class="listen-card__player"
                    id={`panel-${item.id.replace(/\.[^.]+$/, "")}`}
                    role="tabpanel"
                    aria-labelledby={`tab-${item.id.replace(/\.[^.]+$/, "")}-0`}
                  >
                    <div class="listen-player-controls">
                      <button class="listen-play-btn" aria-label="Play">
                        <svg class="icon" aria-hidden="true">
                          <use href="/icons.svg#icon-play" />
                        </svg>
                      </button>
                      <span class="listen-track-title">
                        {item.data.audioTracks![0].title}
                      </span>
                      <div
                        class="mix-toggle"
                        role="group"
                        aria-label="Mix version"
                      >
                        <button class="mix-toggle__btn active" data-mix="rough">
                          Rough
                        </button>
                        <button class="mix-toggle__btn" data-mix="final">
                          Final
                        </button>
                      </div>
                    </div>
                    <div class="listen-waveform" />
                    <div class="listen-time">
                      <span class="listen-time__current">0:00</span>
                      <span class="listen-time__total">0:00</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Portfolio -->
    <section id="portfolio" class="portfolio-section">
      <div class="container">
        <h2 class="section-title">Featured Work</h2>

        <div class="portfolio-filter">
          <button class="filter-btn active" data-filter="all"
            >All Projects</button
          >
          <button class="filter-btn" data-filter="client">Client Work</button>
          <button class="filter-btn" data-filter="personal"
            >Personal Projects</button
          >
        </div>

        <div class="portfolio-gallery">
          {
            portfolioItems.map((item) => {
              const isLocal = item.data.image.startsWith("/images/portfolio/");
              const webpSrc = isLocal
                ? item.data.image.replace(/\.[^.]+$/, ".webp")
                : null;
              return (
                <article
                  class={`portfolio-item ${item.data.client === "Personal Project" ? "personal-project" : "client-project"}`}
                  id={item.slug}
                >
                  <button
                    type="button"
                    class="portfolio-trigger"
                    data-title={item.data.title}
                    data-role={item.data.role}
                    data-client={item.data.client || "Client"}
                    data-description={item.data.description}
                    data-image={item.data.image}
                    data-url={item.data.url}
                  >
                    {isLocal ? (
                      <picture>
                        <source srcset={webpSrc} type="image/webp" />
                        <img
                          src={item.data.image}
                          alt={item.data.title}
                          class="portfolio-image"
                          loading="lazy"
                          width="350"
                          height="250"
                        />
                      </picture>
                    ) : (
                      <img
                        src={item.data.image}
                        alt={item.data.title}
                        class="portfolio-image"
                        loading="lazy"
                        width="350"
                        height="250"
                      />
                    )}
                    <div class="portfolio-info">
                      <h3>{item.data.title}</h3>
                      <p>{item.data.role}</p>
                      {item.data.client === "Personal Project" ? (
                        <span class="project-badge personal">Personal</span>
                      ) : (
                        <span class="project-badge client">
                          {item.data.client ?? "Client"}
                        </span>
                      )}
                    </div>
                  </button>
                </article>
              );
            })
          }
        </div>

        <div class="portfolio-modal" id="portfolio-modal" aria-hidden="true">
          <div class="portfolio-modal__backdrop" data-modal-close></div>
          <div
            class="portfolio-modal__dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="portfolio-modal-title"
            tabindex="-1"
          >
            <div class="portfolio-modal__media-wrap">
              <img
                src=""
                alt=""
                class="portfolio-modal__image"
                id="portfolio-modal-image"
              />
            </div>
            <div class="portfolio-modal__content">
              <p class="portfolio-modal__label" id="portfolio-modal-client"></p>
              <h3 id="portfolio-modal-title"></h3>
              <p class="portfolio-modal__role" id="portfolio-modal-role"></p>
              <p
                class="portfolio-modal__description"
                id="portfolio-modal-description"
              >
              </p>
              <a
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary portfolio-modal__link"
                id="portfolio-modal-link"
              >
                Visit Project
              </a>
            </div>
            <button
              type="button"
              class="portfolio-modal__close"
              data-modal-close
              aria-label="Close project details"
            >
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="contact-section">
      <div class="container">
        <h2 class="section-title">Get Started</h2>
        <div class="contact-content">
          <div class="contact-info">
            <p>
              <svg class="icon contact-icon" aria-hidden="true"
                ><use href="/icons.svg#icon-envelope"></use></svg
              >
              {contact.email}
            </p>
            <p>
              <svg class="icon contact-icon" aria-hidden="true"
                ><use href="/icons.svg#icon-phone"></use></svg
              >
              {contact.phone}
            </p>
            <p>
              <svg class="icon contact-icon" aria-hidden="true"
                ><use href="/icons.svg#icon-map-marker-alt"></use></svg
              >
              {contact.location}
            </p>
            <div class="social-links">
              {
                contact.socialLinks.map((social) => (
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                    aria-label={social.platform}
                  >
                    <svg class="icon" aria-hidden="true">
                      <use
                        href={`/icons.svg#${socialIconMap[social.icon] || "icon-hashtag"}`}
                      />
                    </svg>
                  </a>
                ))
              }
            </div>

            <div class="bandcamp-follow">
              <iframe
                title="Follow Ryan Gildea on Bandcamp"
                scrolling="no"
                style="border: 0;width: 100%;height: 33px;"
                src="https://bandcamp.com/band_follow_button_classic/1087522331"
              ></iframe>
            </div>
          </div>
          <form
            class="contact-form"
            name="contact"
            method="POST"
            netlify-honeypot="bot-field"
            data-netlify="true"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p style="display: none">
              <label for="bot-field"
                >Don't fill this out: <input
                  id="bot-field"
                  name="bot-field"
                /></label
              >
            </p>
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group">
              <label for="subject">Subject</label>
              <input type="text" id="subject" name="subject" />
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" required
              ></textarea>
            </div>
            <button type="submit" class="submit-button">Send Message</button>
          </form>
        </div>
      </div>
    </section>
  </main>
  <script>
    import { initAudioPlayers } from "../scripts/audio-player.js";
    initAudioPlayers();
  </script>
</Base>
