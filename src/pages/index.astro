---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { marked } from "marked";
import DOMPurify from "isomorphic-dompurify";

import about from "../data/about.json";
import contact from "../data/contact.json";

const portfolioItems = (await getCollection("portfolio")).sort(
  (a, b) => a.data.order - b.data.order
);
const audioItems = portfolioItems.filter(
  (item) => item.data.audioTracks && item.data.audioTracks.length > 0,
);
const aboutBioHtml = DOMPurify.sanitize(marked.parse(about.bio), {
  ALLOWED_TAGS: ["p", "strong", "em", "a", "ul", "ol", "li", "br", "h1", "h2", "h3", "h4", "h5", "h6"],
  ALLOWED_ATTR: ["href", "target", "rel"],
});
---

<Base title="Ryan Gildea | Audio Engineer & Producer" hasListenSection={audioItems.length > 0}>
  <!-- Hero -->
  <header class="hero">
    <div class="hero-backgrounds">
      <div class="hero-bg bg-1"></div>
      <div class="hero-bg bg-2"></div>
      <div class="hero-bg bg-3"></div>
    </div>
    <div class="hero-content">
      <h1 id="hero-name" class="hero-title">Ryan Gildea</h1>
      <h4>Music Production | Mixing | Mastering</h4>
      <a href="#contact" class="cta-button">Hire Me</a>
      <div class="spotify-direct-embed">
        <iframe
          style="border-radius: 12px"
          src="https://open.spotify.com/embed/playlist/3kybqFlT51pOHXhIsLoSOz?utm_source=generator&theme=0"
          title="Featured playlist by Ryan Gildea"
          width="100%"
          class="spotify-iframe"
          frameborder="0"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="eager"
        ></iframe>
      </div>
    </div>
    <a href="#about" class="scroll-indicator" aria-label="Scroll to About section">
      <div class="scroll-text">Scroll for more</div>
      <div class="scroll-arrow"><i class="fas fa-chevron-down"></i></div>
    </a>
  </header>

  <main>
    <!-- About -->
    <section id="about" class="about-section">
      <div class="container">
        <h2 class="section-title">About Me</h2>
        <div class="about-content">
          <div class="about-text" set:html={aboutBioHtml} />
          <div class="skills">
            <h3>Skills</h3>
            <ul class="skill-list">
              {about.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Portfolio -->
    <section id="portfolio" class="portfolio-section">
      <div class="container">
        <h2 class="section-title">Featured Work</h2>

        <div class="portfolio-filter">
          <button class="filter-btn active" data-filter="all">All Projects</button>
          <button class="filter-btn" data-filter="client">Client Work</button>
          <button class="filter-btn" data-filter="personal">Personal Projects</button>
        </div>

        <div class="portfolio-gallery">
          {portfolioItems.map((item) => (
            <article
              class={`portfolio-item ${item.data.client === "Personal Project" ? "personal-project" : "client-project"}`}
              id={item.slug}
            >
              <button
                type="button"
                class="portfolio-trigger"
                data-title={item.data.title}
                data-role={item.data.role}
                data-client={item.data.client || "Client"}
                data-description={item.data.description}
                data-image={item.data.image}
                data-url={item.data.url}
              >
                <Image
                  src={item.data.image}
                  alt={item.data.title}
                  class="portfolio-image"
                  loading="lazy"
                  width={350}
                  height={250}
                  format="webp"
                />
                <div class="portfolio-info">
                  <h3>{item.data.title}</h3>
                  <p>{item.data.role}</p>
                  {item.data.client === "Personal Project" && (
                    <span class="project-badge personal">Personal Project</span>
                  )}
                </div>
              </button>
            </article>
          ))}
        </div>

        <div class="portfolio-modal" id="portfolio-modal" aria-hidden="true">
          <div class="portfolio-modal__backdrop" data-modal-close></div>
          <div
            class="portfolio-modal__dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="portfolio-modal-title"
            tabindex="-1"
          >
            <button type="button" class="portfolio-modal__close" data-modal-close aria-label="Close project details">
              <span aria-hidden="true">&times;</span>
            </button>
            <div class="portfolio-modal__media-wrap">
              <img src="" alt="" class="portfolio-modal__image" id="portfolio-modal-image" />
            </div>
            <div class="portfolio-modal__content">
              <p class="portfolio-modal__label" id="portfolio-modal-client"></p>
              <h3 id="portfolio-modal-title"></h3>
              <p class="portfolio-modal__role" id="portfolio-modal-role"></p>
              <p class="portfolio-modal__description" id="portfolio-modal-description"></p>
              <a
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="cta-button portfolio-modal__link"
                id="portfolio-modal-link"
              >
                Visit Project
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Listen -->
    {audioItems.length > 0 && (
      <section id="listen" class="listen-section">
        <div class="container">
          <h2 class="section-title">Rough vs. Final</h2>
          <div class="listen-cards">
            {audioItems.map((item) => (
              <div
                class="listen-card"
                data-tracks={JSON.stringify(item.data.audioTracks)}
              >
                <div class="listen-card__header">
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    class="listen-card__thumb"
                    width="48"
                    height="48"
                    loading="lazy"
                  />
                  <div class="listen-card__meta">
                    <div class="listen-card__artist-name">{item.data.title}</div>
                    <div class="listen-card__role">{item.data.role}</div>
                  </div>
                </div>

                <div class="listen-card__tabs" role="tablist" aria-label="Tracks">
                  {item.data.audioTracks!.map((track, i) => (
                    <button
                      type="button"
                      id={`tab-${item.id.replace(/\.[^.]+$/, '')}-${i}`}
                      class={`listen-tab${i === 0 ? " active" : ""}`}
                      role="tab"
                      aria-selected={i === 0 ? 'true' : 'false'}
                      aria-controls={`panel-${item.id.replace(/\.[^.]+$/, '')}`}
                      tabindex={i === 0 ? 0 : -1}
                      data-track-index={String(i)}
                    >
                      {track.title}
                    </button>
                  ))}
                </div>

                <div
                  class="listen-card__player"
                  id={`panel-${item.id.replace(/\.[^.]+$/, '')}`}
                  role="tabpanel"
                  aria-labelledby={`tab-${item.id.replace(/\.[^.]+$/, '')}-0`}
                >
                  <div class="listen-player-controls">
                    <button class="listen-play-btn" aria-label="Play">
                      <i class="fas fa-play"></i>
                    </button>
                    <span class="listen-track-title">
                      {item.data.audioTracks![0].title}
                    </span>
                    <div class="mix-toggle" role="group" aria-label="Mix version">
                      <button class="mix-toggle__btn active" data-mix="rough">Rough</button>
                      <button class="mix-toggle__btn" data-mix="final">Final</button>
                    </div>
                  </div>
                  <div class="listen-waveform"></div>
                  <div class="listen-time">
                    <span class="listen-time__current">0:00</span>
                    <span class="listen-time__total">0:00</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Contact -->
    <section id="contact" class="contact-section">
      <div class="container">
        <h2 class="section-title">Get In Touch</h2>
        <div class="contact-content">
          <div class="contact-info">
            <p><i class="fas fa-envelope"></i> {contact.email}</p>
            <p><i class="fas fa-phone"></i> {contact.phone}</p>
            <p><i class="fas fa-map-marker-alt"></i> {contact.location}</p>
            <div class="social-links">
              {contact.socialLinks.map((social) => (
                <a href={social.url} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={social.platform}>
                  <i class={`fab ${social.icon}`}></i>
                </a>
              ))}
            </div>

            <div class="bandcamp-follow">
              <iframe
              scrolling="no"
              style="border: 0;width: 100%;height: 33px;"
              src="https://bandcamp.com/band_follow_button_classic/1087522331"
              ></iframe>
            </div>
          </div>
          <form
            class="contact-form"
            name="contact"
            method="POST"
            netlify-honeypot="bot-field"
            data-netlify="true"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p style="display: none">
              <label for="bot-field">Don't fill this out: <input id="bot-field" name="bot-field" /></label>
            </p>
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group">
              <label for="subject">Subject</label>
              <input type="text" id="subject" name="subject" />
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>
            <button type="submit" class="submit-button">Send Message</button>
          </form>
        </div>
      </div>
    </section>
  </main>
  <script>
    import { initAudioPlayers } from '../scripts/audio-player.js';
    initAudioPlayers();
  </script>
</Base>
