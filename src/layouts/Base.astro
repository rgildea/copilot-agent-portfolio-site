---
export interface Props {
  title?: string;
  hasListenSection?: boolean;
}
const { title = "Ryan Gildea | Audio Engineer & Producer", hasListenSection = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ryan Gildea — audio engineer, producer, and mixer. Portfolio of mixing and production work." />
    <title>{title}</title>

    <link rel="preload" href="/fonts/lazer84.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/images/hero-background.webp" as="image" type="image/webp" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#52c1d1" />

    <style>
      html, body {
        overflow-x: hidden;
        margin: 0;
        font-family: "Open Sans", sans-serif;
      }
      body { position: relative; }
      .synthwave-wrapper {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        z-index: 0; pointer-events: none; opacity: 0.8;
      }
      .site-content { position: relative; z-index: 10; }
      .navbar {
        background: rgba(6, 4, 29, 0.75); /* opaque enough for white nav link contrast */
        padding: 1rem 0; position: fixed; width: 100%; top: 0; z-index: 1001;
      }
      .nav-links { pointer-events: auto; }
      .nav-links a {
        position: relative; z-index: 1002; cursor: pointer; user-select: none;
      }
      .container { max-width: 1200px; margin: 0 auto; padding: 0 15px; }
      .webp .hero { background-image: url("/images/hero-background.webp"); }
      .no-webp .hero { background-image: url("/images/hero-background.jpg"); }
      .preloader {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: #000; display: flex; justify-content: center;
        align-items: center; z-index: 9999; transition: opacity 0.5s ease-out;
      }
      .preloader.loaded { opacity: 0; pointer-events: none; }
      .loader {
        width: 60px; height: 60px; border: 4px solid rgba(255,255,255,0.3);
        border-radius: 50%; border-top-color: #ff00ff;
        animation: spin 1s ease-in-out infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
    </style>

    <link rel="stylesheet" href="/css/main.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="/css/synthwave.css" media="print" onload="this.media='all'" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />

    <noscript>
      <link rel="stylesheet" href="/css/main.css" />
      <link rel="stylesheet" href="/css/synthwave.css" />
      <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet" />
    </noscript>

    <script is:inline>
      (function () {
        var WebP = new Image();
        WebP.onload = WebP.onerror = function () {
          document.documentElement.classList.add(WebP.height === 2 ? "webp" : "no-webp");
        };
        WebP.src = "data:image/webp;base64,UklGRjoAAABXRUJQVlA4IC4AAACyAgCdASoCAAIALmk0mk0iIiIiIgBoSygABc6WWgAA/veff/0PP8bA//LwYAAA";
      })();
    </script>
  </head>

  <body class="synthwave-bg">
    <div class="preloader"><div class="loader"></div></div>

    <div class="synthwave-wrapper">
      <div class="grid-overlay"></div>
      <div class="synthwave-sun"></div>
      <div class="horizon-line"></div>
    </div>

    <div class="site-content">
      <nav class="navbar">
        <div class="container">
          <div class="navbar-inner">
            <div id="navbar-title">Ryan Gildea</div>
            <ul class="nav-links">
              <li><a href="/#about">About</a></li>
              <li><a href="/#portfolio">Portfolio</a></li>
              {hasListenSection && <li><a href="/#listen">Listen</a></li>}
              <li><a href="/#contact">Contact</a></li>
            </ul>
          </div>
        </div>
      </nav>

      <slot />

      <footer class="site-footer">
        <div class="container">
          <p>&copy; {new Date().getFullYear()} Ryan Gildea. All rights reserved.</p>
        </div>
      </footer>
    </div>

    <script src="/js/script.js" defer></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        setTimeout(function () {
          document.querySelector(".preloader").classList.add("loaded");
        }, 200);
      });
    </script>
  </body>
</html>
