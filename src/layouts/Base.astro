---
export interface Props {
  title?: string;
  hasListenSection?: boolean;
}
const { title = "Ryan Gildea | Audio Engineer & Producer", hasListenSection = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ryan Gildea — audio engineer, producer, and mixer. Portfolio of mixing and production work." />
    <title>{title}</title>

    <link rel="preload" href="/images/hero-background.webp" as="image" type="image/webp" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF3D7F" />

    <style>
      html, body {
        overflow-x: hidden;
        margin: 0;
        font-family: "Hanken Grotesk", system-ui, sans-serif;
      }
      body { position: relative; background: #16130E; }
      .site-content { position: relative; }
      .navbar {
        background: transparent;
        padding: 0; position: fixed; width: 100%; top: 0; z-index: 1000;
      }
      .nav-links { pointer-events: auto; }
      .nav-links a {
        position: relative; z-index: 1001; cursor: pointer; user-select: none;
      }

.preloader {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: #16130E; display: flex; justify-content: center;
        align-items: center; z-index: 9999; transition: opacity 0.5s ease-out;
      }
      .preloader.loaded { opacity: 0; pointer-events: none; }
      .loader {
        width: 60px; height: 60px; border: 4px solid rgba(255,255,255,0.1);
        border-radius: 50%; border-top-color: #FF3D7F;
        animation: spin 1s ease-in-out infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
    </style>

    <link rel="stylesheet" href="/css/main.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <script is:inline>
      (function () {
        var WebP = new Image();
        WebP.onload = WebP.onerror = function () {
          document.documentElement.classList.add(WebP.height === 2 ? "webp" : "no-webp");
        };
        WebP.src = "data:image/webp;base64,UklGRjoAAABXRUJQVlA4IC4AAACyAgCdASoCAAIALmk0mk0iIiIiIgBoSygABc6WWgAA/veff/0PP8bA//LwYAAA";
      })();
    </script>
  </head>

  <body>
    <div class="preloader"><div class="loader"></div></div>

    <!-- Always-on film grain overlay -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <div class="site-content">
      <nav class="navbar">
        <div class="container">
          <div class="navbar-inner">
            <a href="/" class="navbar-mark" id="navbar-title" aria-label="Ryan Gildea" tabindex="-1">
              <span class="ghost-teal" aria-hidden="true">RYAN GILDEA</span>
              <span class="ghost-pink" aria-hidden="true">RYAN GILDEA</span>
              <span class="bone" aria-hidden="true">RYAN GILDEA</span>
            </a>
            <ul class="nav-links">
              <li><a href="/#about">About</a></li>
              <li><a href="/#portfolio">Portfolio</a></li>
              {hasListenSection && <li><a href="/#listen">Listen</a></li>}
              <li><a href="/#contact">Contact</a></li>
            </ul>
            <a href="/#contact" class="nav-cta">Get Started</a>
          </div>
        </div>
      </nav>

      <slot />

      <footer class="site-footer">
        <div class="container">
          <p>&copy; {new Date().getFullYear()} Ryan Gildea. All rights reserved.</p>
        </div>
      </footer>
    </div>

    <script src="/js/script.js" defer></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        setTimeout(function () {
          document.querySelector(".preloader").classList.add("loaded");
        }, 200);
      });
    </script>
  </body>
</html>
