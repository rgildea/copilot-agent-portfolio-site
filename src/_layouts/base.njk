<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {{ title | default("Ryan Gildea | Audio Engineer & Producer") }}
    </title>
    <!-- Preload critical fonts -->
    <link
      rel="preload"
      href="/fonts/lazer84.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Preload hero image -->
    <link
      rel="preload"
      href="/images/hero-background.webp"
      as="image"
      type="image/webp"
    />

    <!-- Critical CSS inlined -->
    <style>
      html,
      body {
        height: 100%;
        overflow-x: hidden;
        margin: 0;
        font-family: "Open Sans", sans-serif;
      }

      body {
        position: relative;
        overflow-y: auto;
      }

      /* Toned down synthwave wrapper with reduced z-index */
      .synthwave-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0; /* Reduced from 1 to 0 */
        pointer-events: none;
        opacity: 0.8; /* Added subtle opacity */
      }

      .site-content {
        position: relative;
        z-index: 10;
      }

      /* Navbar critical styles */
      .navbar {
        background: rgba(0, 0, 0, 0.7);
        padding: 1rem 0;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
      }

      .logo {
        font-weight: bold;
        font-size: 1.5rem;
      }

      /* Add image format fallbacks */
      .webp .hero {
        background-image: url("/images/hero-background.webp");
      }
      .no-webp .hero {
        background-image: url("/images/hero-background.jpg");
      }

      /* Preloader styles */
      .preloader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #000;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        transition: opacity 0.5s ease-out;
      }

      .preloader.loaded {
        opacity: 0;
        pointer-events: none;
      }

      .loader {
        width: 60px;
        height: 60px;
        border: 4px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: #ff00ff;
        animation: spin 1s ease-in-out infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
    </style>

    <!-- Non-critical CSS loaded asynchronously -->
    <link
      rel="stylesheet"
      href="/css/main.css"
      media="print"
      onload="this.media='all'"
    />
    <link
      rel="stylesheet"
      href="/css/fonts.css"
      media="print"
      onload="this.media='all'"
    />
    <link
      rel="stylesheet"
      href="/css/hero-font.css"
      media="print"
      onload="this.media='all'"
    />
    <link
      rel="stylesheet"
      href="/css/synthwave.css"
      media="print"
      onload="this.media='all'"
    />

    <!-- Font Awesome loaded with defer -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      media="print"
      onload="this.media='all'"
    />

    <!-- Google Fonts with preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Open+Sans:wght@300;400;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />

    <!-- Fallbacks for async CSS -->
    <noscript>
      <link rel="stylesheet" href="/css/main.css" />
      <link rel="stylesheet" href="/css/fonts.css" />
      <link rel="stylesheet" href="/css/hero-font.css" />
      <link rel="stylesheet" href="/css/synthwave.css" />
      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      />
      <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Open+Sans:wght@300;400;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Detect WebP support -->
    <script>
      // WebP detection
      ;(function () {
        var WebP = new Image()
        WebP.onload = WebP.onerror = function () {
          document.documentElement.classList.add(
            WebP.height === 2 ? "webp" : "no-webp"
          )
        }
        WebP.src =
          "data:image/webp;base64,UklGRjoAAABXRUJQVlA4IC4AAACyAgCdASoCAAIALmk0mk0iIiIiIgBoSygABc6WWgAA/veff/0PP8bA//LwYAAA"
      })()
    </script>

    <script
      src="https://identity.netlify.com/v1/netlify-identity-widget.js"
      defer
    ></script>
  </head>
  <body class="synthwave-bg">
    <!-- Preloader -->
    <div class="preloader">
      <div class="loader"></div>
    </div>

    <!-- Simplified synthwave background elements -->
    <div class="synthwave-wrapper">
      <div class="grid-overlay"></div>
      <div class="synthwave-sun"></div>
      <div class="horizon-line"></div>
    </div>

    <div class="site-content">
      <nav class="navbar">
        <div class="container">
          <div class="navbar-inner">
            <div id="navbar-title">Ryan Gildea</div>
            <ul class="nav-links">
              {% if sections.showAbout %}
              <li><a href="/#about">About</a></li>
              {% endif %} {% if sections.showServices %}
              <li><a href="/#services">Services</a></li>
              {% endif %} {% if sections.showPortfolio %}
              <li><a href="/#portfolio">Portfolio</a></li>
              {% endif %} {% if sections.showContact %}
              <li><a href="/#contact">Contact</a></li>
              {% endif %}
            </ul>
          </div>
        </div>
      </nav>

      {{ content | safe }}

      <footer class="site-footer">
        <div class="container">
          <p>
            &copy; {{ "now" | date("yyyy") }} Ryan Gildea. All rights reserved.
          </p>
        </div>
      </footer>
    </div>

    <script src="/js/script.js" defer></script>
    <script>
      // Hide preloader when page is loaded
      window.addEventListener("load", function () {
        setTimeout(function () {
          document.querySelector(".preloader").classList.add("loaded")
        }, 500) // Short delay to ensure smooth transition
      })

      // Using IntersectionObserver for scroll detection
      document.addEventListener("DOMContentLoaded", function() {
        console.log("🔥 Inline script loaded - setting up with IntersectionObserver");
        
        // Get references to key elements
        const navbar = document.querySelector(".navbar");
        const navbarTitle = document.querySelector("#navbar-title");
        
        // Create a sentinel element to observe
        const sentinel = document.createElement("div");
        sentinel.style.position = "absolute";
        sentinel.style.top = "100px"; // Same as our scroll threshold
        sentinel.style.left = "0";
        sentinel.style.width = "100%";
        sentinel.style.height = "1px";
        sentinel.style.visibility = "hidden";
        sentinel.id = "scroll-sentinel";
        document.body.appendChild(sentinel);
        console.log("✅ Created sentinel element at 100px for observation");

        // Set up the intersection observer
        const observer = new IntersectionObserver(
          function(entries) {
            // When sentinel goes in or out of view
            entries.forEach(entry => {
              console.log(`🔎 Intersection: ${entry.isIntersecting ? "In view" : "Out of view"}`);
              
              if (!entry.isIntersecting) {
                // Scrolled past the threshold - show header background and animate
                navbar.classList.add("scrolled");
                console.log("📌 Adding scrolled class - animating title in");
              } else {
                // Back at the top - hide header background and reset animation
                navbar.classList.remove("scrolled");
                console.log("📌 Removing scrolled class - resetting animation");
              }
            });
          },
          {
            threshold: 0,
            rootMargin: "0px 0px 0px 0px"
          }
        );
        
        // Start observing
        observer.observe(sentinel);
        console.log("✅ IntersectionObserver started watching sentinel");
      });

      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", (user) => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/"
            })
          }
        })
      }
    </script>
  </body>
</html>
